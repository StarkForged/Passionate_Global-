# Copy to .env.local for local testing. On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Never commit real keys.

# Resend (https://resend.com): an API key with sending access for the verified domain passionateglobal.co.in
RESEND_API_KEY=
RESEND_FROM_EMAIL="Passionate Global <website@passionateglobal.co.in>"
CONTACT_TO_EMAIL=hitesh@passionateglobal.co.in

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget, widget mode "Invisible").
# The SITE key is public and is baked into the front end at BUILD time: redeploy after changing it.
# Turnstile is enforced by the API only when TURNSTILE_SECRET_KEY is set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional shared rate-limit store (Upstash Redis REST, or Upstash via the Vercel Marketplace which sets KV_REST_API_*).
# Without it the limit (5 enquiries / hour / IP) is kept in memory per function instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
