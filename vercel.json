{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src https://challenges.cloudflare.com; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/",
      "permanent": true
    },
    {
      "source": "/index(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/",
      "permanent": true
    },
    {
      "source": "/about-us(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/?from=about",
      "permanent": true
    },
    {
      "source": "/services(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/?from=services",
      "permanent": true
    },
    {
      "source": "/infrastructure(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/?from=security",
      "permanent": true
    },
    {
      "source": "/career(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/?from=life",
      "permanent": true
    },
    {
      "source": "/contact-us(\\.html|/)?",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/?from=contact",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "passionateglobal.co.in"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?passionatestaffing\\.com"
        }
      ],
      "destination": "https://www.passionateglobal.co.in/",
      "permanent": true
    }
  ]
}
